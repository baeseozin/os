# 이 파일을 복사해서 .env 로 만든 뒤 실제 값으로 채우세요.
#   cp .env.example .env

# 연구실 Llama 모델 서버 (OpenAI 호환 API) 주소. 끝에 /v1 까지 포함.
# 예: http://192.168.0.10:8000/v1
LLAMA_BASE_URL=http://<서버주소>:<포트>/v1

# API 키 (서버에서 인증이 필요한 경우에만)
LLAMA_API_KEY=

# 사용할 모델 이름 (기본값과 같으면 비워둬도 됨)
LLAMA_MODEL=meta-llama/Llama-3.3-70B-Instruct
